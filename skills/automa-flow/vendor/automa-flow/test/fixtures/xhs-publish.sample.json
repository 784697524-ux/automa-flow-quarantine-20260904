tVariable('hasRow', true);\n  automaSetVariable('recordId', row.recordId ?? row.id);\n  for (const [column, varName] of Object.entries(CONFIG.fieldMap)) {\n    automaSetVariable(varName, toText(row.fields[column]));\n  }\n automaNextBlock();\n}","preloadScripts":[],"everyNewTab":false,"runBeforeLoad":false},"label":"javascript-code"},{"id":"6ga94i1","type":"BlockConditions","initialized":false,"position":{"x":1020.0884505405813,"y":262.73106266313636},"data":{"description":"","disableBlock":false,"conditions":[{"id":"rmCvtQixspCeLSVQ-sjhr","name":"hasRow","conditions":[{"id":"gOnIR3sMhvm7Uts6z7mq6","conditions":[{"id":"NSMhMGT2BR6t4Gxvl0XVC","items":[{"type":"value","category":"value","data":{"value":"{{variables@hasRow}}"},"id":"AxR8uM9WM-Um4ViSMksjS"},{"id":"MFo09lt2OoMBSZVuBvR32","category":"compare","type":"eq"},{"id":"EqdJYA_bLQ1emt0KX9fX5","type":"value","category":"value","data":{"value":"true"}}]}]}]}],"retryConditions":false,"retryCount":10,"retryTimeout":1000},"label":"conditions"},{"id":"6bx9ah7","type":"BlockBasicWithFallback","initialized":false,"position":{"x":1050.563109093339,"y":613.4296057925109},"data":{"disableBlock":false,"description":"","url":"https://api.dingtalk.com/v1.0/notable/bases/BASE_SAMPLE/sheets/SHEET_SAMPLE/records?operatorId={{secrets@dingtalkOperatorId}}","body":"{\n  \"records\":\n  [\n    {\n      \"id\":\"{{variables@recordId}}\",\n      \"fields\":\n      {\n        \"状态\":\"已发布\"\n      }\n    }\n  ]\n}","headers":[{"name":"Content-Type","value":"application/json"},{"name":"x-acs-dingtalk-access-token","value":"{{variables@tokenResp.accessToken}}"}],"method":"PUT","timeout":10000,"dataPath":"","contentType":"json","variableName":"","assignVariable":false,"saveData":false,"dataColumn":"","responseType":"json"},"label":"webhook"},{"id":"knw6htu","type":"BlockBasic","initialized":false,"position":{"x":61.11768843754862,"y":627.3409649581461},"data":{"disableBlock":false,"findBy":"cssSelector","waitForSelector":false,"waitSelecto